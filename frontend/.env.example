# DevAssist frontend configuration.
# Copy to `.env` if you need to override the defaults.

# Base URL of the DevAssist FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Optional explicit WebSocket URL. When empty it is derived from
# VITE_API_BASE_URL as ws(s)://<host>/ws/chat
VITE_WS_URL=
