# DevAssist Chatbot — backend configuration.
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

# Required: create a key at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_groq_api_key

# Groq chat model identifier. Verify a currently supported model in the Groq
# console before changing. Examples of current production models:
#   llama-3.3-70b-versatile
#   llama-3.1-8b-instant
#   openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile

# Generation settings
GROQ_TEMPERATURE=0.2
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_TIMEOUT_SECONDS=60

# Allowed browser origin for CORS (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Upload + RAG limits
MAX_UPLOAD_BYTES=5242880
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
MAX_CONTEXT_TOKENS=4000
MAX_QUESTION_CHARS=4000

# Local embedding model (downloaded on first start)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
